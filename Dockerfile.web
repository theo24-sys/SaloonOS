# ServiceProof web — Next.js (rewrites /api/* to the Django service).
# NOTE: rewrite destinations are baked in at build time, so API_ORIGIN is a build ARG.
FROM node:22-slim
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
ARG API_ORIGIN=http://api:8000
ENV API_ORIGIN=$API_ORIGIN
RUN npm run build
EXPOSE 3000
CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
