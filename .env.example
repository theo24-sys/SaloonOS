# ---- Backend (Django) ----
# Generate a real one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=your-api.example.com

# EITHER a single DATABASE_URL (hosted Postgres: Render/Neon/Supabase give you exactly this)
DATABASE_URL=postgres://user:password@host:5432/serviceproof
# OR the individual parts (local dev default):
# DB_NAME=serviceproof
# DB_USER=serviceproof
# DB_PASSWORD=sp_dev_2026
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Where customers' phones will open bills — encoded into every QR code.
# MUST be the public frontend URL (https://...), not localhost.
PUBLIC_BASE_URL=https://your-frontend.example.com

# Comma-separated. Same-origin proxying means this can stay empty in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ----
# Where the Django API lives (the proxy target). Default: http://127.0.0.1:8000
API_ORIGIN=http://127.0.0.1:8000

# ---- M-Pesa (Daraja) — plan payments ----
# Get these from developer.safaricom.co.ke → My Apps → Live API (or sandbox for testing)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=            # your Paybill/Till number
MPESA_ENVIRONMENT=production   # sandbox | production
# Daraja must reach the callback over public HTTPS. Leave unset on Render
# (auto-derived); set it explicitly when proxying another way.
# MPESA_CALLBACK_URL=https://saloonos-api.onrender.com/api/mpesa/callback/
# Optional shared secret; Daraja callers must append ?token=... to the callback.
# MPESA_CALLBACK_TOKEN=some-long-random-string
# Simulate STK pushes without real keys (dev only!)
# MPESA_SIMULATE=0
